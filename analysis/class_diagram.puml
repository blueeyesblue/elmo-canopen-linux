@startuml Elmo_CANopen_Class_Diagram
!theme plain
title Elmo CANopen 项目类图 (标准UML)

' 设置样式
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam packageStyle rectangle

package "CAN Communication Layer" {
    struct TCan {
        - char* iface
        - struct sockaddr_can addr
        - struct ifreq ifr
        - unsigned int id
        - int socket
    }
    
    class CANFunctions <<utility>> {
        + {static} TCanConstruct(const char* iface) : TCan*
        + {static} TCanDestruct(TCan* can) : void
        + {static} TCanOpen(TCan* can, int canid) : int
        + {static} TCanClose(TCan* can) : int
        + {static} setOperational(TCan* can) : int
        + {static} setPreOperational(TCan* can) : int
        + {static} createFrame(can_frame* frame, int id, int size, char* data) : void
        + {static} sendFrame(TCan* can, can_frame* frame) : int
        + {static} sendPDO2(TCan* can, int size, char* data) : int
        + {static} receivePDO2(TCan* can, can_frame* frame) : int
        + {static} sendPDO2DiscardReply(TCan* can, int size, char* data) : int
        + {static} setDataInt(char* data, int value) : void
        + {static} setDataFloat(char* data, float value) : void
        + {static} intFromData(char* data) : int
        + {static} floatFromData(char* data) : float
    }
    
    note right of CANFunctions : can.h / can.c\n独立的C函数集合\n非面向对象设计
}

package "Motor Control Layer" {
    enum Mode {
        MODE_POS = 5
        MODE_TORQUE = 1
    }
    
    class ElmoModule <<module>> {
        + sendEchoMessage(TCan* can) : int
        + setPosition(TCan* can, int pos) : int
        + getPosition(TCan* can, int* pos) : int
        + setForce(TCan* can, float force) : int
        + getForce(TCan* can, float* force) : int
        + startMotor(TCan* can) : int
        + stopMotor(TCan* can) : int
        + beginMotion(TCan* can) : int
        + stop(TCan* can) : int
        + setUnitMode(TCan* can, Mode mode) : int
        + setSpeed(TCan* can, int speed) : int
        + setAbsolutePosition(TCan* can, int pos) : int
        + setRelativePosition(TCan* can, int pos) : int
        + setTorque(TCan* can, float torque) : int
        + getMaxCurrent(TCan* can, float* current) : int
        + setLimits(TCan* can, int vmin, int vmax, float fmin, float fmax) : int
    }
}

package "Application Layer" {
    class MainModule <<module>> {
        + main() : int
        + test(TCan* can) : void
        + test_position(TCan* can) : void
        + test_force(TCan* can) : void
        + print_info(TCan* can) : void
    }
}

package "Configuration" {
    class Config <<utility>> {
        + {static} CAN_INTERFACE = "can0"
        + {static} CANOPEN_ID = 127
        + {static} PDO2_COB_ID_SEND = 0x301-0x37f
        + {static} RPDO2_COB_ID_RECV = 0x281-0x2ff
    }
}

package "Protocol" {
    interface CANopenProtocol {
        + PDO_COMMUNICATION
        + POSITION_CONTROL_MODE
        + TORQUE_CONTROL_MODE
        + ASCII_COMMAND_FORMAT
        + DATA_LENGTH_4_8_BYTES
    }
}

' UML 关系定义
' 依赖关系 - CANFunctions 操作 TCan 结构体
CANFunctions ..> TCan : operates on

' 依赖关系 - ElmoModule 使用 CANFunctions 和 TCan
ElmoModule ..> CANFunctions : uses
ElmoModule ..> TCan : uses

' 依赖关系 - ElmoModule 使用 Mode 枚举
ElmoModule ..> Mode : uses

' 依赖关系 - MainModule 使用其他模块
MainModule ..> ElmoModule : uses
MainModule ..> TCan : uses

' 实现关系 - CANFunctions 实现 CANopen 协议
CANFunctions ..|> CANopenProtocol : implements

' 使用关系 - 各模块使用配置
CANFunctions ..> Config : uses
ElmoModule ..> Config : uses
MainModule ..> Config : uses

' 注释
note right of TCan : CAN设备结构体\n存储socket连接信息\n由C函数操作
note right of Mode : 电机控制模式枚举\n位置控制/扭矩控制
note bottom of CANFunctions : CAN通信函数集合\n(can.h/can.c)\n独立的C函数
note bottom of ElmoModule : Elmo电机控制函数\n(elmo.h/elmo.c)\n高级控制接口
note bottom of MainModule : 应用程序入口\n(main.c)\n测试和演示功能

@enduml